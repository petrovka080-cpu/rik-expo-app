{
  "include": [
    "src/lib/estimate/**/*.ts",
    "src/lib/estimate/**/*.tsx"
  ],
  "exclude": [
    ".release-runtime/**/*",
    ".tmp/**/*",
    "artifacts/**/*",
    "diagnostics/**/*",
    "diagnostics/archive/migrated/**/*",
    "migrated/**/*",
    "scripts/diagnostics/root-legacy/**/*",
    "tmp/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck/estimate-implementation.tsbuildinfo"
  },
  "extends": "./tsconfig.json"
}
