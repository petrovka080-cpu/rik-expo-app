{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck/tests-rest.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    ".release-runtime/**/*",
    ".tmp/**/*",
    "artifacts/**/*",
    "diagnostics/**/*",
    "diagnostics/archive/migrated/**/*",
    "migrated/**/*",
    "scripts/diagnostics/root-legacy/**/*",
    "tmp/**/*",
    "tests/ai/**/*",
    "tests/api/**/*",
    "tests/architecture/**/*",
    "tests/e2e/**/*",
    "tests/estimate*/**/*", "tests/aiEstimateV4/**/*", "tests/requestEstimate/**/*", "tests/consumerRepair/**/*",
    "tests/a*/**/*", "tests/b*/**/*", "tests/c*/**/*", "tests/d*/**/*", "tests/e*/**/*", "tests/f*/**/*",
    "tests/g*/**/*", "tests/h*/**/*", "tests/i*/**/*", "tests/j*/**/*", "tests/k*/**/*", "tests/l*/**/*", "tests/m*/**/*", "tests/n*/**/*", "tests/o*/**/*", "tests/p*/**/*"
  ]
}
