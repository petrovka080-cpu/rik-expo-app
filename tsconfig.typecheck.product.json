{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck/product.tsbuildinfo"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "supabase/**/*.ts",
    "supabase/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "App.tsx",
    "playwright.config.ts"
  ],
  "exclude": [
    ".release-runtime/**/*",
    ".tmp/**/*",
    "artifacts/**/*",
    "diagnostics/**/*",
    "diagnostics/archive/migrated/**/*",
    "migrated/**/*",
    "scripts/diagnostics/root-legacy/**/*",
    "tmp/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
