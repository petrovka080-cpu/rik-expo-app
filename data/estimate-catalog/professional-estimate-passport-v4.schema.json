{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-estimate-passport-v4.schema.json",
  "title": "ProfessionalEstimatePassportV4",
  "type": "object",
  "required": ["passportId", "catalogWorkId", "version", "classification", "identity", "applicability", "exclusions", "parameters", "calculation", "boq", "sources", "pricing", "migration", "evidence"],
  "properties": {
    "passportId": { "type": "string", "minLength": 1 },
    "catalogWorkId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "classification": { "type": "object" },
    "identity": { "type": "object" },
    "applicability": { "type": "array" },
    "exclusions": { "type": "array" },
    "parameters": { "type": "object" },
    "calculation": {
      "type": "object",
      "required": ["calculationStrategyId", "formulaGraphVersion", "formulaGraph", "sharedPrimitives", "dimensionalContract", "roundingPolicy"]
    },
    "boq": { "type": "object" },
    "sources": { "type": "object" },
    "pricing": { "type": "object" },
    "migration": {
      "type": "object",
      "required": ["previousPassportVersions", "legacyTemplateIds", "semanticOwner"]
    },
    "evidence": { "type": "object" }
  },
  "additionalProperties": false
}
