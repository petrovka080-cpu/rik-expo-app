    "agent_may_mark_technical_readiness_only": true
  },
  "hard_stop_statuses": {
    "role_based_uat_not_ready": "STOP_PILOT_LAUNCH_READINESS_BLOCKED_BY_ROLE_BASED_UAT",
    "dirty_worktree_before_start": "STOP_DIRTY_WORKTREE_BEFORE_PILOT_LAUNCH_READINESS",
    "android_emulator_unavailable": "STOP_ANDROID_EMULATOR_NOT_AVAILABLE_FOR_PILOT_LAUNCH_NO_GREEN"
  },
  "acceptance": {
    "go_no_go_policy_created": true,
    "p0_blocks_go": true,
    "p1_requires_owner_acceptance_if_nonzero": true,
    "web_android_smoke_required": true,
    "kill_switch_and_rollback_required": true,
    "owner_approval_not_faked": true
  }
}
