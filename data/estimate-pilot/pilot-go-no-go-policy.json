{
  "schema": "ai-estimate-pilot-launch-go-no-go-policy-v1",
  "policy_id": "pilot-launch-go-no-go-v1",
  "go_allowed_only_if": {
    "p0_defects_count": 0,
    "p1_defects_count_zero_or_owner_accepted": true,
    "web_pilot_launch_smoke_passed": true,
    "android_pilot_launch_smoke_passed": true,
    "daily_regression_passed": true,
    "no_pdf_snapshot_mismatch": true,
    "no_buyer_invalid_handoff": true,
    "no_raw_dump_visible": true,
    "no_empty_positions_after_valid_prompt": true,
    "no_fake_total_when_prices_missing": true,
    "support_secret_scan_passed": true,
    "kill_switch_rehearsal_passed": true,
    "rollback_rehearsal_passed": true,
    "artifact_lineage_audit_passed": true,
    "owner_go_no_go_status_in": [
      "PENDING_OWNER_REVIEW",
      "APPROVED"
    ]
  },
  "owner_controls": {
    "owner_approval_must_not_be_faked": true,
    "default_owner_go_no_go_status": "PENDING_OWNER_REVIEW",
