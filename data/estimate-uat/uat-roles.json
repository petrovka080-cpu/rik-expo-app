{
  "schema": "ai-estimate-role-based-uat-roles-v1",
  "roles": [
    {
      "role_id": "ESTIMATOR",
      "allowed_actions": [
        "view_parser_result",
        "view_missing_params",
        "edit_assumptions",
        "inspect_formulas",
        "view_norm_sources",
        "create_review_feedback"
      ],
      "blocked_actions": [
        "approve_owner_signoff",
        "edit_procurement_only_package",
        "mark_ai_price_as_trusted"
      ],
      "required_views": [
        "parser_result",
        "missing_params",
        "grouped_draft",
        "details_drawer",
        "formula_trace",
        "norm_sources"
      ],
      "required_exports": [
        "feedback_item"
      ],
      "acceptance_criteria": [
        "parser_result_visible",
        "missing_params_visible",
        "assumptions_editable",
        "formula_trace_visible",
        "norm_sources_visible",
        "feedback_can_be_created"
      ],
      "critical_failures": [
        "parser_result_missing",
        "grouped_draft_missing",
        "formula_trace_missing",
        "silent_quantity_correction"
      ]
    },
    {
      "role_id": "DIRECTOR",
      "allowed_actions": [
        "view_grouped_estimate",
        "view_trust_level",
        "view_commercial_level",
        "view_price_completeness",
        "open_pdf",
        "view_assumptions_and_limitations"
      ],
      "blocked_actions": [
        "override_missing_prices_as_total",
        "approve_owner_signoff",
        "edit_formula_without_review"
      ],
      "required_views": [
        "grouped_estimate",
        "trust_level",
        "commercial_level",
        "price_completeness",
        "pdf",
        "assumptions",
        "limitations"
      ],
      "required_exports": [
        "pdf_snapshot"
      ],
      "acceptance_criteria": [
        "grouped_estimate_visible",
        "trust_level_visible",
        "commercial_level_visible",
        "missing_price_state_visible",
        "pdf_generated_from_snapshot"
      ],
      "critical_failures": [
        "fake_final_total",
        "trust_level_missing",
        "pdf_missing",
        "pdf_not_from_snapshot"
      ]
    },
    {
      "role_id": "PROCUREMENT_BUYER",
      "allowed_actions": [
        "view_procurement_package",
        "export_procurement_package",
        "view_material_equipment_service_quantities",
        "create_procurement_feedback"
