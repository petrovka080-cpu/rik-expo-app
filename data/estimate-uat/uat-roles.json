      ],
      "critical_failures": [
        "work_package_missing",
        "quantity_missing",
        "procurement_only_confusion"
      ]
    },
    {
      "role_id": "CLIENT_VIEWER",
      "allowed_actions": [
        "view_clean_summary",
        "open_client_pdf",
        "view_assumptions",
        "view_price_state"
