      ],
      "required_views": [
        "procurement_package",
        "material_rows",
        "equipment_rows",
        "procurement_service_rows",
        "snapshot_quantity_trace"
      ],
      "required_exports": [
        "procurement_package"
      ],
      "acceptance_criteria": [
        "procurement_package_created",
        "no_labor_rows",
        "no_debug_rows",
        "no_formula_rows",
        "quantities_match_snapshot"
      ],
      "critical_failures": [
        "buyer_receives_work_rows",
        "buyer_receives_helper_rows",
        "buyer_quantity_mismatch",
        "wrong_unit_in_procurement"
      ]
