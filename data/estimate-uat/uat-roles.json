      ],
      "acceptance_criteria": [
        "clean_summary_visible",
        "no_raw_formulas_in_main_table",
        "no_raw_json",
        "no_internal_template_ids"
      ],
      "critical_failures": [
        "raw_json_visible",
        "debug_formula_visible",
        "internal_template_id_visible"
      ]
