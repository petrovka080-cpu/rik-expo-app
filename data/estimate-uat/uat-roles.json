    {
      "role_id": "FOREMAN",
      "allowed_actions": [
        "view_work_packages",
        "view_scope",
        "view_quantities",
        "create_execution_feedback"
      ],
      "blocked_actions": [
        "approve_pricebook",
        "send_procurement_package",
        "approve_owner_signoff"
