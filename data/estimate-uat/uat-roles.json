        "export_private_phone",
        "export_private_email",
        "approve_owner_signoff"
      ],
      "required_views": [
        "redacted_support_package",
        "telemetry_summary",
        "failure_reason",
        "artifact_lineage"
      ],
      "required_exports": [
        "redacted_support_package"
      ],
      "acceptance_criteria": [
        "support_package_exportable",
        "support_package_redacted",
        "telemetry_redacted",
        "failure_reason_visible"
      ],
      "critical_failures": [
        "secret_leaked",
        "private_phone_leaked",
        "private_email_leaked",
        "failure_reason_missing"
      ]
