  "automaticFormulaContract": {
    "trenchExcavationM3": "sum(section_length_m * section_trench_bottom_width_m * section_trench_depth_m)",
    "beddingM3": "sum(section_length_m * section_trench_bottom_width_m * section_bedding_thickness_m)",
    "pipeExternalDisplacementM3": "route_length_m * pi * pow(pipe_outside_diameter_mm / 1000, 2) / 4",
    "surroundMaterialM3": "sum(section_length_m * section_surround_width_m * (pipe_outside_diameter_mm / 1000 + section_surround_cover_above_pipe_m)) - pipe_external_displacement_m3",
    "backfillPlacementM3": "trench_excavation_m3 - bedding_m3 - surround_gross_zone_m3",
    "importedBackfillM3": "max(0, backfill_placement_m3 - trench_excavation_m3 * excavated_soil_reuse_fraction)",
    "excessSoilM3": "max(0, trench_excavation_m3 - min(trench_excavation_m3 * excavated_soil_reuse_fraction, backfill_placement_m3))",
    "straightPipeJointPiece": "max(0, ceil(route_length_m / installation_piece_length_m) - 1)",
    "fusionConsumableSet": "straight_pipe_joint_piece * fusion_consumable_set_per_joint",
    "flangeConnectionKitSet": "flanged_connection_piece * flange_kit_per_connection",
    "temporaryTestEndClosurePiece": "hydrotest_section_count * temporary_end_closure_per_test_section",
    "routeMarkingConsumableSet": "ceil(route_length_m / 100) * visible_route_marking_set_per_100m",
    "compactionWaterM3": "backfill_placement_m3 * visible_compaction_water_m3_per_backfill_m3",
    "chamberJointSealantKg": "chamber_piece * visible_sealant_kg_per_chamber",
    "coverBeddingMortarKg": "chamber_piece * covers_per_chamber * visible_mortar_kg_per_cover",
    "trenchSupportM2WhenRequired": "supported_length_m * trench_depth_m * 2 sides",
    "flushingWaterM3": "route_length_m * pi * pow(pipe_inside_diameter_mm / 1000, 2) / 4 * flushing_volume_multiplier",
    "disinfectionReagentKg": "flushing_water_m3 * disinfection_reagent_dose_mg_l / 1000",
    "pipeGrossNeedM": "installed_m * (1 + expected_loss_fraction) + retained_spare_m",
    "pipeNetOrderNeedM": "max(0, pipe_gross_need_m - available_stock_m)",
    "pipeOrderedM": "ceil(pipe_net_order_need_m / supplier_segment_length_m) * supplier_segment_length_m",
    "laborAndMachineTime": "calculated quantity multiplied by applicable unit labor, or divided by applicable productivity"
  },
