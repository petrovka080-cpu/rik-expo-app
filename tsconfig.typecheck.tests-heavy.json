  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck/tests-heavy.tsbuildinfo"
  },
  "include": [
    "tests/ai/**/*.ts",
    "tests/ai/**/*.tsx",
    "tests/api/**/*.ts",
