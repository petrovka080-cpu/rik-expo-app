{
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/typecheck/features-implementation.tsbuildinfo",
    "incremental": true
  },
  "extends": "./tsconfig.json",
  "exclude": [
    ".release-runtime/**/*",
    ".tmp/**/*",
    "artifacts/**/*",
    "diagnostics/**/*",
    "diagnostics/archive/migrated/**/*",
    "migrated/**/*",
    "scripts/diagnostics/root-legacy/**/*",
    "tmp/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "include": [
    "src/features/**/*.ts",
    "src/features/**/*.tsx"
  ]
}
