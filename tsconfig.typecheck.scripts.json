{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/typecheck/scripts.tsbuildinfo"
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ],
  "exclude": [
    ".release-runtime/**/*", ".tmp/**/*", "artifacts/**/*", "diagnostics/**/*",
    "diagnostics/archive/migrated/**/*", "migrated/**/*", "scripts/diagnostics/root-legacy/**/*", "tmp/**/*",
    "scripts/estimate/**/*"
  ]
}
